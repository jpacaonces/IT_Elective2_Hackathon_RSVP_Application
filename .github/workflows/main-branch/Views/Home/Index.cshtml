@{
    ViewData["Title"] = "Home";
}

<section class="invite-card">
    <p class="eyebrow">You are cordially invited to</p>
    <h1>Every Event, One Reply</h1>
    <p class="lede">
        Browse upcoming events and let us know if you'll be attending &mdash;
        it only takes a moment.
    </p>
    <div class="card-actions">
        <a class="btn btn-primary" href="/Event">View Events</a>
        <a class="btn btn-ghost" href="/Account/Login">Sign in</a>
    </div>
</section>

<section class="info-strip">
    <div class="info-item">
        <span class="info-number">01</span>
        <p>Sign in with the account your team gave you.</p>
    </div>
    <div class="info-item">
        <span class="info-number">02</span>
        <p>Pick the event you're invited to.</p>
    </div>
    <div class="info-item">
        <span class="info-number">03</span>
        <p>Submit your RSVP and you're all set.</p>
    </div>
</section>
