@{
    ViewData["Title"] = "RSVP Form";
    Layout = "_Layout";
    var selectedEvent = ViewBag.SelectedEvent as RSVPApp.Models.Event;
    var userDisplayName = ViewBag.UserDisplayName as string ?? "";
}

<div class="container py-5" style="max-width: 680px;">

    <!-- BACK BUTTON -->
    <a href="/Home/Index" class="btn btn-sm btn-outline-secondary mb-4 rounded-3">
        ← Back to Events
    </a>

    @if (selectedEvent != null)
    {
        <!-- EVENT HEADER CARD -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="p-4 text-white" style="background-color: @(selectedEvent.BannerColor ?? "#7c3aed");">
                <span class="badge bg-light text-dark mb-2">📌 @selectedEvent.Category</span>
                <h2 class="h4 fw-bold mb-1">@selectedEvent.Title</h2>
                <p class="mb-0 opacity-75">Hosted by @selectedEvent.Host</p>
            </div>
            <div class="card-body p-3 bg-light d-flex justify-content-between text-muted small">
                <span>📅 @selectedEvent.Date</span>
                <span>📍 @selectedEvent.Location</span>
            </div>
        </div>
    }

    <!-- FORM CARD -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h3 class="h5 fw-bold mb-3">Reserve Your Spot</h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-3" role="alert">
                    ⚠️ @ViewBag.Error
                </div>
            }

            <form asp-controller="Rsvp" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="eventId" value="@selectedEvent?.Id" />

                <!-- GUEST NAME -->
                <div class="mb-3">
                    <label for="guestName" class="form-label fw-semibold">Your Name</label>
                    <input type="text"
                           class="form-control rounded-3"
                           id="guestName"
                           name="guestName"
                           value="@userDisplayName"
                           placeholder="John Doe"
                           required />
                </div>

                <!-- EMAIL -->
                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">Email Address</label>
                    <input type="email"
                           class="form-control rounded-3"
                           id="email"
                           name="email"
                           placeholder="john@example.com"
                           required />
                </div>

                <!-- NUMBER OF GUESTS -->
                <div class="mb-3">
                    <label for="numberOfGuests" class="form-label fw-semibold">Number of Guests</label>
                    <input type="number"
                           class="form-control rounded-3"
                           id="numberOfGuests"
                           name="numberOfGuests"
                           value="1"
                           min="1"
                           max="10"
                           required />
                </div>

                <!-- ATTENDANCE STATUS -->
                <div class="mb-4">
                    <label class="form-label fw-semibold d-block">Will you be attending?</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="isAttending" id="attendingYes" value="true" checked>
                        <label class="form-check-label" for="attendingYes">Yes, I'll be there!</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="isAttending" id="attendingNo" value="false">
                        <label class="form-check-label" for="attendingNo">Sorry, can't make it</label>
                    </div>
                </div>

                <!-- SUBMIT BUTTON -->
                <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold" style="background-color: #7c3aed; border: none;">
                    Submit RSVP
                </button>
            </form>
        </div>
    </div>
</div>