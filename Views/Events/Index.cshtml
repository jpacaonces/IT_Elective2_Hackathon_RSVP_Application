@model List<RSVPApp.Models.Event>

@{
    ViewData["Title"] = "Events";
}


<div class="events-page">

    <section class="events-header">

        <span class="events-badge">
            ✨ Upcoming Invitations
        </span>

        <h1>
            Discover Your Events
        </h1>

        <p>
            Browse available events and confirm your attendance.
        </p>

    </section>



    <div class="events-container">

        @foreach (var item in Model)
        {

            <div class="event-card-modern">


                <div class="event-top">

                    <div class="event-icon">
                        📅
                    </div>


                    <span class="event-date">
                        @item.Date.ToString("MMM dd, yyyy")
                    </span>

                </div>



                <h2>
                    @item.Name
                </h2>


                <p class="event-description">
                    @item.Description
                </p>



                <div class="event-info">

                    <div>
                        📍
                        @item.Location
                    </div>


                    <div>
                        ⏰
                        @item.Date.ToString("hh:mm tt")
                    </div>

                </div>



                <a asp-controller="Rsvp"
                   asp-action="Create"
                   asp-route-id="@item.Id"
                   class="event-button">

                    Confirm RSVP →

                </a>


            </div>

        }

    </div>


</div>



<style>


    .events-page {
        padding: 70px 8%;
    }



    /* HEADER */

    .events-header {
        text-align: center;
        margin-bottom: 60px;
    }


    .events-badge {
        display: inline-block;
        background: #dbeafe;
        color: #2563eb;
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 600;
    }



    .events-header h1 {
        margin-top: 25px;
        font-size: 55px;
        font-weight: 800;
        color: #0f172a;
    }



    .events-header p {
        color: #64748b;
        font-size: 18px;
    }




    /* GRID */


    .events-container {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(300px,1fr));
        gap: 35px;
    }




    /* CARD */


    .event-card-modern {
        background: white;
        padding: 35px;
        border-radius: 25px;
        box-shadow: 0 20px 50px rgba(0,0,0,.12);
        position: relative;
        overflow: hidden;
        transition: .3s;
    }



        .event-card-modern:hover {
            transform: translateY(-10px);
            box-shadow: 0 30px 70px rgba(0,0,0,.18);
        }



        .event-card-modern::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg,#2563eb,#7c3aed);
        }



    /* TOP */


    .event-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }



    .event-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #eff6ff;
        font-size: 30px;
    }



    .event-date {
        color: #2563eb;
        font-weight: 700;
    }




    /* TEXT */


    .event-card-modern h2 {
        margin-top: 25px;
        font-size: 28px;
        color: #0f172a;
    }



    .event-description {
        color: #64748b;
        margin-top: 15px;
        min-height: 60px;
    }



    /* INFO */


    .event-info {
        margin-top: 25px;
        padding: 20px 0;
        border-top: 1px solid #e5e7eb;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        gap: 12px;
        color: #475569;
    }



    /* BUTTON */


    .event-button {
        display: block;
        margin-top: 25px;
        text-align: center;
        padding: 14px;
        background: #2563eb;
        color: white;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        transition: .3s;
    }



        .event-button:hover {
            background: #7c3aed;
            color: white;
        }



    /* MOBILE */


    @@media(max - width:700px) {

        .events-header h1 {
            font-size: 38px;
        }
    }

</style>